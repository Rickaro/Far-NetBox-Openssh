            VALUE "LegalTrademarks", "\0"
            VALUE "OriginalFilename", "SshBox.dll\0"
            VALUE "ProductName", "SshBox\0"
            VALUE "ProductVersion", PLUGIN_VERSION_STR "\0"
            VALUE "ReleaseType", "beta\0"
            VALUE "WWW", "https://github.com/Rickaro/Far-NetBox-Openssh\0"
        }
    }

    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0, 0x04E4
    }
}
